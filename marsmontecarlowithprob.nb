   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"yearth", "[", "t", "]"}], "-", 
      RowBox[{"ymars", "[", "t", "]"}]}], ")"}], "/", 
    RowBox[{"distearthmars", "[", "t", "]"}]}]}], ";"}]], "Input",
