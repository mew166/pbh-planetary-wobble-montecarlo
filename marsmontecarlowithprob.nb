Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"sampling", " ", "sanity", " ", "check", " ", "here"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "mcEvents", "]"}], ",", 
     RowBox[{"Max", "[", 
      RowBox[{"Norm", "/@", 
       RowBox[{"mcEvents", "[", 
