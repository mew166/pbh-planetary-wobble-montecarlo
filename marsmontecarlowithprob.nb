     RowBox[{"(*", 
      RowBox[{"just", " ", "under", " ", "50"}], "*)"}], 
     RowBox[{"Mean", "[", 
      RowBox[{"mcEvents", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1", ",", "3"}], "]"}], "]"}], "]"}], ",", 
     RowBox[{"(*", 
      RowBox[{"near", " ", "0"}], "*)"}], 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
