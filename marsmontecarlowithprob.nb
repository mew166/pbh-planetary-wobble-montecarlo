Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
  "This", " ", "final", " ", "segment", " ", "calculates", " ", "the", " ", 
   "change", " ", "in", " ", "distance", " ", "between", " ", "Earth", " ", 
   "and", " ", "Mars"}], " ", "*)"}]], "Input",
 CellChangeTimes->{{4.000108485821286*^9, 4.000108505446789*^9}},
 CellLabel->
  "In[254]:=",ExpressionUUID->"15255ce4-7c22-4f8e-b0f6-ceee43b1c09e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"distearthmars", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"xearth", "[", "t", "]"}], "-", 
        RowBox[{"xmars", "[", "t", "]"}]}], ")"}], "^", "2"}], " ", "+", " ", 
     
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"yearth", "[", "t", "]"}], "-", 
        RowBox[{"ymars", "[", "t", "]"}]}], ")"}], "^", "2"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{4.000109025537719*^9, 4.000109064727022*^9}},
 CellLabel->
  "In[255]:=",ExpressionUUID->"f2faf3a6-4da3-4248-a20e-1e5c62ab52a1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"nearthmarsx", "[", "t_", "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"xearth", "[", "t", "]"}], "-", 
      RowBox[{"xmars", "[", "t", "]"}]}], ")"}], "/", 
    RowBox[{"distearthmars", "[", "t", "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{4.000109071050851*^9, 4.0001090962132893`*^9}},
 CellLabel->
  "In[256]:=",ExpressionUUID->"9f5d7fad-3c03-490d-82d8-a119734e92d4"],

