Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"tranestimate", "[", "t_", "]"}], ":=", 
   RowBox[{"autom", "*", "prefactmars", "*", 
    RowBox[{"(", 
     RowBox[{"t", "-", "tzero"}], ")"}], "*", 
    RowBox[{
     RowBox[{"HeavisideTheta", "[", 
      RowBox[{"t", "-", "tzero"}], "]"}], "/", 
     RowBox[{"Sqrt", "[", "rminsquaremars", "]"}]}]}]}], ";"}]], "Input",
