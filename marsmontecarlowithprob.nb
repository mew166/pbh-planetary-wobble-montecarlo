  "In[257]:=",ExpressionUUID->"2725eb3c-a492-4eee-85ac-ba884badcced"],

Cell[BoxData[
 RowBox[{
  RowBox[{"autom", "=", 
   RowBox[{"1.496", "*", 
    RowBox[{"(", 
     RowBox[{"10", "^", "11"}], ")"}]}]}], ";"}]], "Input",
 CellLabel->
  "In[258]:=",ExpressionUUID->"f9917028-9214-4f15-99ee-aa57e30e2042"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"deltaearthmars", "[", "t_", "]"}], ":=", 
   RowBox[{"autom", "*", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"deltaxearth", "[", "t", "]"}], "-", 
          RowBox[{"deltaxmars", "[", "t", "]"}]}], ")"}], "*", 
        RowBox[{"nearthmarsx", "[", "t", "]"}]}], ")"}], "+", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"deltayearth", "[", "t", "]"}], "-", 
          RowBox[{"deltaymars", "[", "t", "]"}]}], ")"}], "*", 
        RowBox[{"nearthmarsy", "[", "t", "]"}]}], ")"}]}], ")"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{4.00010912255184*^9, 4.000109193112414*^9}, {
  4.000109238776613*^9, 4.0001092413918037`*^9}, {4.000113785390229*^9, 
