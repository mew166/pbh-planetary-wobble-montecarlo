      RowBox[{"\"\<Mars\>\"", ",", "mcEvNotebook", ",", "mus0", ",", "tgB"}], 
      "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.003231579749099*^9, 4.003231579752616*^9}},
 CellLabel->
  "In[274]:=",ExpressionUUID->"7f2d75c0-efaa-4bed-9566-6d134348d3f5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", "Cell"}]}]}]}]}], " ", "2", 
     RowBox[{"b", ":", 
      RowBox[{
      "check", " ", "of", " ", "the", " ", "full", " ", "response", " ", 
       "against", " ", "the", " ", "secular", " ", "formula"}]}]}], ",", 
    RowBox[{
     RowBox[{"Sun", "'"}], "s", " ", "kick", " ", "off", " ", "so", " ", 
     "both", " ", "use", " ", "the", " ", "same", " ", 
     RowBox[{"physics", ".", "the"}], " ", "two", " ", "should", " ", "agree",
      " ", "to", " ", "roughly", " ", "10", "%", " ", "at", " ", "late", " ", 
     "times", " ", "and", " ", "the", " ", "full", " ", "one", " ", "should", 
     " ", "be", " ", "exactly", " ", "0", " ", "before", " ", "the", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"kick", "--"}], "--"}], "--"}], "--"}], "--"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"mcSunKick", "=", "False"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dFull", "=", 
     RowBox[{"mcDeltaR", "[", 
      RowBox[{"\"\<Mars\>\"", ",", "mcEvNotebook", ",", "mus0", ",", "tgB"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dSec", "=", 
     RowBox[{"mcDeltaR", "[", 
      RowBox[{
      "\"\<Mars\>\"", ",", "mcEvNotebook", ",", "mus0", ",", "tgB", ",", 
       "mcDispSecular"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"mcSunKick", "=", "True"}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"Pick", "[", 
        RowBox[{"dFull", ",", 
         RowBox[{"Thread", "[", 
          RowBox[{"tgB", "<", "tzero"}], "]"}]}], "]"}], "]"}], "]"}], ",", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", "dSec", "]"}], "]"}], ",", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"dFull", "-", "dSec"}], "]"}], "]"}]}], "}"}], "\n", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"tgB", ",", "dFull"}], "}"}], "]"}], ",", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"tgB", ",", "dSec"}], "}"}], "]"}]}], "}"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<full\>\"", ",", "\"\<secular\>\""}], "}"}]}]}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", "Cell"}]}]}]}]}], " ", "3"}], ":", 
     RowBox[{"sampling", " ", "random", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"flybys", "--"}], "--"}], "--"}], "--"}], "--"}]}]}], 
    "*)"}], 
   RowBox[{
    RowBox[{
     RowBox[{"mcSample", "[", 
      RowBox[{"bmax_", ",", "t0_", ",", "Tobs_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "c", ",", "ph", ",", "v", ",", "h", ",", "e1", ",", "e2", ",", "b", 
         ",", "psi", ",", "bv"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{"isotropic", " ", "direction"}], "*)"}], 
       RowBox[{
        RowBox[{"c", "=", 
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ph", "=", 
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"2", " ", "Pi"}]}], "}"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"v", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{"1", "-", 
              RowBox[{"c", "^", "2"}]}], "]"}], " ", 
            RowBox[{"Cos", "[", "ph", "]"}]}], ",", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{"1", "-", 
              RowBox[{"c", "^", "2"}]}], "]"}], " ", 
            RowBox[{"Sin", "[", "ph", "]"}]}], ",", "c"}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "two", " ", "unit", " ", "vectors", " ", "perpendicular", " ", "to", 
          " ", "v"}], "*)"}], 
        RowBox[{"h", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", "c", "]"}], "<", "0.9"}], ",", 
           RowBox[{"{", 
            RowBox[{"0.", ",", "0.", ",", "1."}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1.", ",", "0.", ",", "0."}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"e1", "=", 
         RowBox[{"Normalize", "[", 
          RowBox[{"Cross", "[", 
           RowBox[{"v", ",", "h"}], "]"}], "]"}]}], ";", 
        RowBox[{"e2", "=", 
         RowBox[{"Cross", "[", 
          RowBox[{"v", ",", "e1"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"impact", " ", "vector"}], ",", 
          RowBox[{
          "uniform", " ", "over", " ", "a", " ", "disk", " ", "of", " ", 
           "radius", " ", "bmax"}]}], "*)"}], 
        RowBox[{"b", "=", 
         RowBox[{"bmax", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"RandomReal", "[", "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"psi", "=", 
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"2", " ", "Pi"}]}], "}"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"bv", "=", 
         RowBox[{"b", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Cos", "[", "psi", "]"}], " ", "e1"}], "+", 
            RowBox[{
             RowBox[{"Sin", "[", "psi", "]"}], " ", "e2"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"v", ",", "bv", ",", 
          RowBox[{"RandomReal", "[", 
           RowBox[{"{", 
            RowBox[{"t0", ",", 
             RowBox[{"t0", "+", "Tobs"}]}], "}"}], "]"}]}], "}"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"mcBmax", "=", "50."}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"au", ",", 
     RowBox[{"radius", " ", "of", " ", "the", " ", "target", " ", "disk", " ", 
      RowBox[{"(", 
       RowBox[{"as", " ", "in", " ", "Tran", " ", "et", " ", 
        RowBox[{"al", "."}]}], ")"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"mcT0", "=", "0."}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"start", " ", "of", " ", "the", " ", "window"}], ",", "yr"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"mcTobs", "=", "26."}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"length", " ", "of", " ", "the", " ", "window"}], ",", "yr"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"mcN", "=", "200000"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"number", " ", "of", " ", "events"}], ",", 
     RowBox[{
     "20", " ", "000", " ", "took", " ", "a", " ", "few", " ", "seconds", " ",
       "so", " ", "this", " ", "should", " ", "take", " ", "a", " ", "minute",
       " ", "or", " ", "two"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"mcEvents", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"mcSample", "[", 
        RowBox[{"mcBmax", ",", "mcT0", ",", "mcTobs"}], "]"}], ",", 
       RowBox[{"{", "mcN", "}"}]}], "]"}]}], ";"}]}]}]], "Input",
