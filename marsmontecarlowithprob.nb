Cell[BoxData[
 RowBox[{
  RowBox[{"rminsquaremars", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"xmars", "[", "tzero", "]"}], "-", "xzero"}], ")"}], "^", 
      "2"}], ")"}], " ", "+", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"ymars", "[", "tzero", "]"}], "-", "yzero"}], ")"}], "^", 
      "2"}], ")"}], "-", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"xmars", "[", "tzero", "]"}], "-", "xzero"}], ")"}], "*", 
         RowBox[{"(", 
          RowBox[{"vbx", "/", "vb"}], ")"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"ymars", "[", "tzero", "]"}], "-", "yzero"}], ")"}], "*", 
         RowBox[{"(", 
          RowBox[{"vby", "/", "vb"}], ")"}]}]}], " ", ")"}], "^", "2"}], 
     ")"}]}]}], ";"}]], "Input",
