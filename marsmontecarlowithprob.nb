Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"P", 
     RowBox[{"(", 
      RowBox[{"at", " ", "least", " ", "1"}], ")"}], " ", "for", " ", 
     "expected", " ", "count", " ", "n"}], ";", 
    RowBox[{
    "returns", " ", "1", " ", "for", " ", "large", " ", "n", " ", "to", " ", 
     "avoid", " ", "underflow"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"mcP1", "[", "n_", "]"}], ":=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"n", ">", "50."}], ",", "1.", ",", 
       RowBox[{"1", "-", 
        RowBox[{"Exp", "[", 
         RowBox[{"-", "n"}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{"(*", 
    RowBox[{
    "expected", " ", "number", " ", "of", " ", "flybys", " ", "through", " ", 
     "the", " ", "disk", " ", "in", " ", "the", " ", "window"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"mcNpass", "[", "Mg_", "]"}], ":=", 
     RowBox[{
      RowBox[{"mcFlybyRate", "[", 
       RowBox[{"Mg", "/", "1000."}], "]"}], " ", "mcTobs"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"expected", " ", "number", " ", "of", " ", "DETECTABLE", " ", 
     RowBox[{"flybys", ":", 
      RowBox[{
      "passes", " ", "times", " ", "the", " ", "fraction", " ", "with", " ", 
       "q", " ", "above", " ", "threshold"}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"mcNdet", "[", 
      RowBox[{"Mg_", ",", "q0_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"mcNpass", "[", "Mg", "]"}], " ", 
      RowBox[{
       RowBox[{"mcCount", "[", 
        RowBox[{"mcQ1", ",", 
         RowBox[{"Mg", "/", "1000."}], ",", "q0"}], "]"}], "/", 
       RowBox[{"Length", "[", "mcQ1", "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"table", ":", 
      RowBox[{"chance", " ", "of", " ", "a", " ", "pass"}]}], ",", 
     RowBox[{
     "and", " ", "chance", " ", "of", " ", "a", " ", "detection", " ", "for", 
      " ", "each", " ", "threshold"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Mg", ",", 
             RowBox[{"mcP1", "[", 
              RowBox[{"mcNpass", "[", "Mg", "]"}], "]"}]}], "}"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"mcP1", "[", 
              RowBox[{"mcNdet", "[", 
               RowBox[{"Mg", ",", "#"}], "]"}], "]"}], "&"}], "/@", 
            "mcQ0List"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"Mg", ",", 
           RowBox[{"10.", "^", 
            RowBox[{"Range", "[", 
             RowBox[{"18", ",", "23"}], "]"}]}]}], "}"}]}], "]"}], ",", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<M [g]\>\"", ",", "\"\<P(pass)\>\""}], "}"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"\"\<P(detect) q0=\>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"N", "[", "q0", "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"q0", ",", "mcQ0List"}], "}"}]}], "]"}]}], "]"}]}], "]"}],
      ",", 
     RowBox[{"Frame", "->", "All"}]}], "]"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"plot", ":", 
     RowBox[{
     "the", " ", "pass", " ", "probability", " ", "and", " ", "the", " ", 
      "detection", " ", "probability", " ", "for", " ", "each", " ", 
      "threshold"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mcMgPlot", "=", 
     RowBox[{"10", "^", 
      RowBox[{"Range", "[", 
       RowBox[{"18.", ",", "25.", ",", "0.1"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{"ListLogLinearPlot", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"mcMgPlot", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"mcP1", "[", 
               RowBox[{"mcNdet", "[", 
                RowBox[{"#", ",", "q0"}], "]"}], "]"}], "&"}], "/@", 
             "mcMgPlot"}]}], "}"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"q0", ",", "mcQ0List"}], "}"}]}], "]"}], ",", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"mcMgPlot", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"mcP1", "[", 
             RowBox[{"mcNpass", "[", "#", "]"}], "]"}], "&"}], "/@", 
           "mcMgPlot"}]}], "}"}], "]"}]}], "]"}], ",", 
     RowBox[{"Joined", "->", "True"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"Axes", "->", "False"}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1.02"}], "}"}]}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<M_PBH [g]\>\"", ",", "\"\<Probability in 26 yr\>\""}], 
       "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<detect, q0 > \>\"", ",", 
             RowBox[{"N", "[", "q0", "]"}]}], "}"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"q0", ",", "mcQ0List"}], "}"}]}], "]"}], ",", 
        "\"\<a PBH passes through\>\""}], "]"}]}]}], "]"}]}]}]], "Input",
